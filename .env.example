# Copy to .env (never commit .env). Export these in your shell or use a tool like direnv.
AWS_REGION=us-east-1
# A model or inference-profile ID you have ENABLED in the Bedrock console (Model access).
# Look it up in the console; IDs change as models are released/retired.
CLAIMLENS_MODEL_ID=
# Optional: a cheaper/faster model for the classification step. Defaults to CLAIMLENS_MODEL_ID.
CLAIMLENS_CLASSIFY_MODEL_ID=

# --- OCR (Phase 3) ---
# S3 bucket used ONLY for async Textract on multi-page PDFs (temp objects are deleted afterwards).
# Leave empty to fall back to per-page synchronous calls. Bucket should enforce SSE-KMS.
CLAIMLENS_TEXTRACT_BUCKET=
# Mean OCR confidence (0-100) below which a document is routed to human review / escalated to the next engine.
CLAIMLENS_MIN_OCR_CONFIDENCE=80

# --- Storage + API (Phase 4) ---
# SQLite works for quick local dev; use Postgres for anything real.
CLAIMLENS_DATABASE_URL=sqlite:///claimlens.db
# CLAIMLENS_DATABASE_URL=postgresql+psycopg://claimlens:claimlens@localhost:5432/claimlens
# Empty = no Redis fast path (everything still works, just does a database lookup).
CLAIMLENS_REDIS_URL=
# 'sql' (default, local) or 'dynamodb' (production). For DynamoDB Local set CLAIMLENS_DYNAMODB_ENDPOINT=http://localhost:8000
CLAIMLENS_IDEMPOTENCY=sql
CLAIMLENS_DYNAMODB_TABLE=claimlens_idempotency
# token:username:role, comma separated. Roles: reader < uploader < reviewer < admin. Tokens >= 16 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAIMLENS_API_TOKENS=
# bedrock (default) | mock:careful  (mock is for local demos only)
CLAIMLENS_LLM=bedrock
# CLAIMLENS_API_AUTH=disabled   # local dev ONLY. The API refuses to start with no tokens unless this is set.
