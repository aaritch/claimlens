# Copy to .env (never commit .env). Export these in your shell or use a tool like direnv.
AWS_REGION=us-east-1
# A model or inference-profile ID you have ENABLED in the Bedrock console (Model access).
# Look it up in the console; IDs change as models are released/retired.
CLAIMLENS_MODEL_ID=
# Optional: a cheaper/faster model for the classification step. Defaults to CLAIMLENS_MODEL_ID.
CLAIMLENS_CLASSIFY_MODEL_ID=

# --- OCR (Phase 3) ---
# S3 bucket used ONLY for async Textract on multi-page PDFs (temp objects are deleted afterwards).
# Leave empty to fall back to per-page synchronous calls. Bucket should enforce SSE-KMS.
CLAIMLENS_TEXTRACT_BUCKET=
# Mean OCR confidence (0-100) below which a document is routed to human review / escalated to the next engine.
CLAIMLENS_MIN_OCR_CONFIDENCE=80

# --- Storage + API (Phase 4) ---
# SQLite works for quick local dev; use Postgres for anything real.
CLAIMLENS_DATABASE_URL=sqlite:///claimlens.db
# CLAIMLENS_DATABASE_URL=postgresql+psycopg://claimlens:claimlens@localhost:5432/claimlens
# Empty = no Redis fast path (everything still works, just does a database lookup).
CLAIMLENS_REDIS_URL=
# 'sql' (default, local) or 'dynamodb' (production). For DynamoDB Local set CLAIMLENS_DYNAMODB_ENDPOINT=http://localhost:8000
CLAIMLENS_IDEMPOTENCY=sql
CLAIMLENS_DYNAMODB_TABLE=claimlens_idempotency
# token:username:role, comma separated. Roles: reader < uploader < reviewer < admin. Tokens >= 16 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAIMLENS_API_TOKENS=
# bedrock (default) | mock:careful  (mock is for local demos only)
CLAIMLENS_LLM=bedrock
# CLAIMLENS_API_AUTH=disabled   # local dev ONLY. The API refuses to start with no tokens unless this is set.

# --- Worker / deployment (Phase 5). In AWS these are injected by the ECS task definition (see infra/terraform/ecs.tf). ---
# CLAIMLENS_SQS_QUEUE_URL=            # the work queue
# CLAIMLENS_DOCUMENTS_BUCKET=         # uploads bucket (presigned POST + async Textract temp copies)
# CLAIMLENS_WORKER_CONCURRENCY=4
# CLAIMLENS_SYNC_UPLOAD=0             # production: uploads go browser -> S3 -> queue -> worker
# Database/Redis can be given as parts (the app assembles and URL-escapes them):
# CLAIMLENS_DB_HOST= CLAIMLENS_DB_USER= CLAIMLENS_DB_PASSWORD= CLAIMLENS_DB_NAME=claimlens CLAIMLENS_DB_SSLMODE=require
# CLAIMLENS_REDIS_HOST= CLAIMLENS_REDIS_AUTH_TOKEN= CLAIMLENS_REDIS_TLS=1

# --- Security + monitoring (Phases 6-7) ---
CLAIMLENS_OPAQUE_SOURCE_NAMES=1
CLAIMLENS_ENVIRONMENT=dev
CLAIMLENS_METRICS=0
# Optional OIDC ID-token auth; issuer/JWKS must be reachable on approved private networking in AWS.
# CLAIMLENS_OIDC_ISSUER=
# CLAIMLENS_OIDC_AUDIENCE=
# CLAIMLENS_OIDC_JWKS_URL=
# CLAIMLENS_OIDC_ROLES_CLAIM=cognito:groups

# --- Salesforce (Phase 8): dry run by default; live execution requires explicit synthetic-data acknowledgement. ---
# Never commit tokens or put them in command-line arguments. Prefer your secret store.
# CLAIMLENS_SALESFORCE_URL=https://your-org.my.salesforce.com
# CLAIMLENS_SALESFORCE_TOKEN=
# CLAIMLENS_SALESFORCE_OBJECT=Claim__c
# CLAIMLENS_SALESFORCE_EXTERNAL_ID=Document_ID__c
# CLAIMLENS_SALESFORCE_API_VERSION=v61.0
