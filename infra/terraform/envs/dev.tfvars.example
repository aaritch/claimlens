# Infrastructure-only dev stack. Copy to dev.tfvars (git-ignored) and replace placeholders before planning.
project     = "claimlens"
environment = "dev"
aws_region  = "us-east-1"

# Prevent accidental deployment to another authenticated AWS account.
allowed_account_ids = ["REPLACE_WITH_ACCOUNT_ID"]

# Pinned on purpose (see variables.tf). Must exist in aws_region.
availability_zones = ["us-east-1a", "us-east-1b"]

# Preserve data and recovery options. Destructive teardown requires separate operator approval.
deletion_protection  = true
force_destroy        = false
secret_recovery_days = 7

# Bedrock: enable the models in the console first, then list their ARNs (least privilege: no wildcards).
bedrock_model_id          = "" # Set the approved model/profile ID only before service activation.
bedrock_classify_model_id = ""
bedrock_model_arns = [
  "arn:aws:bedrock:us-east-1::foundation-model/REPLACE_WITH_MODEL_ID",
]

# Two-phase rollout: apply with false, push the image, then set image_tag and true.
enable_services = false
image_tag       = ""

alarm_email = ""

# Optional API behind an internal load balancer
enable_api          = false
api_certificate_arn = ""
api_allowed_cidrs   = []
enable_analytics    = false

# Shorter application logs for dev; audit logs retain the default one-year window.
log_retention_days = 14
