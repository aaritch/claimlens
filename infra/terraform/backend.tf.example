# Copy to backend.tf and fill in. State contains secrets (the Redis auth token), so the state bucket must be
# private, versioned and KMS-encrypted, and only the deploy role may read it. Create it OUTSIDE this stack.
#
# Terraform >= 1.10 can lock with S3 alone (use_lockfile = true). Older versions need a DynamoDB lock table.
terraform {
  backend "s3" {
    bucket       = "YOUR-TERRAFORM-STATE-BUCKET"
    key          = "claimlens/dev/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    kms_key_id   = "alias/YOUR-STATE-KEY"
    use_lockfile = true
  }
}
