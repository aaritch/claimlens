# Copy this declaration to backend.tf (git-ignored). Put environment-specific settings from backend.hcl.example
# in a protected private file and pass its absolute path to terraform init -backend-config=<path>.
# State contains the Redis auth token. Use the separate infra/state-bootstrap root for private, versioned,
# KMS-encrypted state storage, and restrict state access to approved deployment principals.
terraform {
  backend "s3" {}
}
